{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/swapravo/.local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/swapravo/.local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && /Users/swapravo/.local/bin/graphify update . >/dev/null 2>&1 && /Users/swapravo/.local/bin/graphify export obsidian --dir graphify-out/obsidian >/dev/null 2>&1 || true",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
